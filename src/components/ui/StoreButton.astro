---
/**
 * Botón de tienda (App Store / Google Play) con icono y etiqueta.
 */
import Icon from './Icon.astro';

interface Props {
  store: 'ios' | 'play';
  href?: string;
  id?: string;
}

const { store, href, id } = Astro.props;

const defaults = {
  ios: {
    url: 'https://www.apple.com/app-store/',
    top: 'Próximamente en',
    name: 'App Store',
    icon: 'apple' as const,
  },
  play: {
    url: 'https://play.google.com/store',
    top: 'Próximamente en',
    name: 'Google Play',
    icon: 'googlePlay' as const,
  },
};

const { url, top, name, icon } = defaults[store];
const finalHref = href ?? url;
---

<a
  href={finalHref}
  id={id}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${name} - ${top}`}
  class="group flex items-center gap-3 rounded-xl border border-white/10 px-5 py-3.5 text-white transition-all duration-300 hover:border-olive-500/30"
  style="background-color: rgba(255, 255, 255, 0.08)"
>
  <Icon name={icon} class="h-7 w-7 flex-shrink-0" />
  <div class="text-left">
    <p class="text-[10px] leading-none text-white/50">{top}</p>
    <p class="text-sm font-medium leading-tight">{name}</p>
  </div>
</a>
