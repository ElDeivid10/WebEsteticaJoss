---
/**
 * Divisor ornamental reutilizable (línea - punto - línea).
 */
interface Props {
  width?: string;
  color?: string;
  class?: string;
}

const { width = 'w-10', color = 'bg-rose-500/40', class: className = '' } = Astro.props;
---

<div class:list={['flex items-center justify-center gap-2', className]} aria-hidden="true">
  <div class:list={['h-px', width, color]}></div>
  <div class="w-1.5 h-1.5 rounded-full bg-rose-500"></div>
  <div class:list={['h-px', width, color]}></div>
</div>
