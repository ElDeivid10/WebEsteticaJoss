---
/**
 * Tarjeta de servicio con icono, título, duración, descripción, sub-servicios y CTA.
 */
import Icon from './Icon.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { id, name, description, duration, icon, requiresDeposit, ariaLabel, subServices } = service;
---

<article
  id={`servicio-${id}`}
  class="group flex flex-col gap-4 rounded-2xl border border-beige-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-olive-500/20 hover:shadow-md"
  aria-label={ariaLabel}
>
  <div
    class="flex h-12 w-12 items-center justify-center rounded-xl bg-olive-500/10 transition-colors duration-300 group-hover:bg-olive-500/20"
    aria-hidden="true"
  >
    <Icon name={icon} class="h-6 w-6 text-olive-500 transition-transform duration-300 group-hover:scale-110" />
  </div>

  <div class="flex-1">
    <div class="mb-2 flex items-start justify-between gap-2">
      <h3 class="font-serif text-lg font-medium text-ink-800">
        {name}
      </h3>
      <span
        class="flex-shrink-0 rounded-full border border-olive-500/20 bg-olive-500/10 px-2 py-0.5 text-[10px] font-semibold tracking-wider text-olive-500 uppercase"
      >
        {duration}
      </span>
    </div>
    <p class="text-ink-800/55 text-sm leading-relaxed font-light">
      {description}
    </p>

    {subServices && subServices.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5" role="list" aria-label={`Tipos de ${name}`}>
        {subServices.map((sub) => (
          <li class="rounded-full bg-olive-50 border border-beige-100 px-2.5 py-0.5 text-[10px] text-olive-600 font-medium">
            {sub.name}
          </li>
        ))}
      </ul>
    )}

    {
      requiresDeposit && (
        <div class="mt-3 flex items-start gap-2 rounded-lg border border-amber-200/70 bg-amber-50 px-3 py-2">
          <Icon name="warning" class="mt-0.5 h-3.5 w-3.5 flex-shrink-0 text-amber-500" />
          <p class="text-[10px] font-medium leading-tight text-amber-700">
            Requiere anticipo mediante la app
          </p>
        </div>
      )
    }
  </div>

  <div class="h-px bg-gradient-to-r from-olive-500/30 to-transparent" aria-hidden="true"></div>

  <a
    href="#app"
    class="text-olive-500 text-xs font-medium tracking-wide transition-all hover:underline underline-offset-2"
  >
    Agendar cita →
  </a>
</article>
