---
/**
 * Encabezado consistente para secciones: eyebrow + título + divider + descripción opcional.
 */
import Divider from './Divider.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'center' | 'start';
  titleClass?: string;
  eyebrowColor?: string;
  descriptionClass?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  titleClass = 'text-rose-300',
  eyebrowColor = 'text-rose-500',
  descriptionClass = 'text-white/60',
} = Astro.props;
---

<div class:list={['mb-14', align === 'center' ? 'text-center' : 'text-start']}>
  <span class:list={['text-xs tracking-[0.3em] uppercase font-medium', eyebrowColor]}>
    {eyebrow}
  </span>
  <h2
    class:list={[
      'mt-3 text-4xl md:text-5xl font-light leading-tight font-serif',
      titleClass,
    ]}
  >
    {title}
  </h2>
  <div class="mt-4">
    <Divider />
  </div>
  {
    description && (
      <p class:list={['mt-4 font-light max-w-md mx-auto text-sm leading-relaxed', descriptionClass, align === 'start' && 'mx-0']}>
        {description}
      </p>
    )
  }
</div>
