---
/**
 * Hero con parallax, orbes decorativas y CTA.
 * La imagen se importa desde src/assets/ para que Astro la optimice.
 */
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero_salon.jpg';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---

<section
  id="hero"
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
  aria-label="Hero del salón de belleza Yoss"
>
  <!-- Imagen con parallax -->
  <div
    id="parallax-bg"
    class="absolute inset-0 scale-110 will-change-transform"
  >
    <Image
      src={heroImage}
      alt=""
      class="h-full w-full object-cover object-top"
      loading="eager"
      fetchpriority="high"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      quality={80}
    />
  </div>

  <!-- Overlay degradado -->
  <div
    class="absolute inset-0 z-[1] bg-gradient-to-b from-ink-800/75 via-ink-800/50 to-ink-800/90"
    aria-hidden="true"
  ></div>

  <!-- Liquid glass orbs -->
  <div class="pointer-events-none absolute inset-0 z-[2] overflow-hidden" aria-hidden="true">
    <div
      class="animate-pulse-slow absolute top-1/4 left-1/4 h-80 w-80 rounded-full opacity-20 blur-3xl"
      style="background: radial-gradient(circle, #a36b7e 0%, transparent 70%); animation-duration: 6s;"
    ></div>
    <div
      class="animate-pulse-slow absolute right-1/4 bottom-1/3 h-56 w-56 rounded-full opacity-15 blur-2xl"
      style="background: radial-gradient(circle, #e8bfcc 0%, transparent 70%); animation-duration: 8s; animation-delay: 2s;"
    ></div>

    <!-- Glass pill "Abierto hoy" -->
    <div
      class="absolute top-24 right-8 hidden items-center gap-2 rounded-full border border-white/10 px-4 py-2 sm:flex md:right-24"
      style="background: rgba(255, 255, 255, 0.06); backdrop-filter: blur(12px);"
    >
      <span
        class="inline-block h-1.5 w-1.5 animate-ping rounded-full bg-rose-500"
        style="animation-duration: 2s;"
        aria-hidden="true"
      ></span>
      <span class="text-[10px] tracking-widest text-white/60 uppercase">Abierto hoy</span>
    </div>
  </div>

  <!-- Contenido del hero -->
  <div
    class="relative z-[3] mx-auto flex max-w-3xl flex-col items-center gap-6 px-6 pt-20 text-center"
  >
    <span
      class="inline-block rounded-full border border-rose-500/30 px-5 py-2 text-xs tracking-[0.35em] text-rose-500 uppercase"
      style="background: rgba(163, 107, 126, 0.12); backdrop-filter: blur(8px);"
    >
      Boutique Salón · {site.location}
    </span>

    <h1
      class="font-serif text-5xl leading-tight font-light tracking-tight text-white md:text-7xl"
    >
      Yoss Beauty<br />
      <em class="not-italic font-extralight text-rose-300">Salon</em>
    </h1>

    <p class="max-w-md text-lg font-light tracking-wide text-white/75 md:text-xl">
      {site.tagline}.
    </p>

    <div class="flex items-center gap-3" aria-hidden="true">
      <div class="h-px w-12 bg-rose-500/60"></div>
      <div class="h-1.5 w-1.5 rounded-full bg-rose-500"></div>
      <div class="h-px w-12 bg-rose-500/60"></div>
    </div>

    <Button
      href="#app"
      id="cta-descargar-app"
      variant="primary"
      size="lg"
      shine
      aria-label="Descargar la app de Yoss Beauty Salon"
    >
      <Icon name="download" class="h-5 w-5 transition-transform duration-300 group-hover:-translate-y-0.5" />
      Descargar App para Agendar
    </Button>

    <!-- Scroll indicator -->
    <div
      class="absolute bottom-8 left-1/2 flex -translate-x-1/2 animate-bounce flex-col items-center gap-1"
      aria-hidden="true"
    >
      <span class="text-[10px] tracking-widest text-white/40 uppercase">Scroll</span>
      <Icon name="chevronDown" class="h-4 w-4 text-white/40" />
    </div>
  </div>
</section>

<script>
  import { initParallax } from '../../lib/parallax';
  initParallax();
</script>
