---
/**
 * Sección "Nuestra Historia" con foto de la dueña, stats y datos de contacto.
 * Parallax en la imagen de fondo.
 */
import { Image } from 'astro:assets';
import ownerImage from '../../assets/images/owner.jpg';
import heroBg from '../../assets/images/hero_salon.jpg';
import { about } from '../../data/about';
import { stats } from '../../data/stats';
import { aboutContactItems } from '../../data/contact';
import SectionHeader from '../ui/SectionHeader.astro';
import Stat from '../ui/Stat.astro';
import ContactItem from '../ui/ContactItem.astro';
import Container from '../ui/Container.astro';
---

<section
  id="nosotros"
  class="relative overflow-hidden px-4 py-24"
  aria-label="Quiénes somos"
>
  <!-- Fondo con parallax -->
  <div
    id="parallax-about"
    class="absolute inset-0 scale-110 will-change-transform"
    style="filter: brightness(0.15) saturate(0.5);"
  >
    <Image
      src={heroBg}
      alt=""
      class="h-full w-full object-cover"
      loading="lazy"
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      quality={70}
    />
  </div>

  <!-- Overlay con gradiente -->
  <div
    class="absolute inset-0 bg-gradient-to-br from-ink-800/95 via-ink-800/85 to-ink-900/95"
    aria-hidden="true"
  ></div>

  <!-- Orb central -->
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-[300px] w-[600px] -translate-x-1/2 rounded-full opacity-10 blur-3xl"
    style="background: radial-gradient(ellipse, #a36b7e 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <Container width="md" class="relative z-10">
    <SectionHeader
      eyebrow="Conoce al equipo"
      title="Nuestra Historia"
      titleClass="text-white"
    />

    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Foto + glass card de la dueña -->
      <div class="flex justify-center lg:justify-start" data-fade-in>
        <div class="relative">
          <!-- Marcos decorativos -->
          <div
            class="absolute -top-3 -left-3 h-full w-full rounded-3xl border border-rose-500/30"
            aria-hidden="true"
          ></div>
          <div
            class="absolute -bottom-3 -right-3 h-full w-full rounded-3xl border border-rose-300/15"
            aria-hidden="true"
          ></div>

          <div class="relative h-80 w-72 overflow-hidden rounded-3xl shadow-2xl">
            <Image
              src={ownerImage}
              alt={about.imageAlt}
              class="h-full w-full object-cover object-top"
              loading="lazy"
              widths={[288, 480, 640]}
              sizes="(min-width: 1024px) 288px, 80vw"
              quality={85}
            />

            <!-- Glass badge nombre -->
            <div
              class="absolute right-4 bottom-4 left-4 rounded-2xl border border-white/15 px-4 py-3"
              style="background: rgba(44, 40, 41, 0.7); backdrop-filter: blur(12px);"
            >
              <p class="font-serif text-sm font-medium text-white">{about.name}</p>
              <p class="mt-0.5 text-[10px] tracking-widest text-rose-500 uppercase">
                {about.role}
              </p>
            </div>
          </div>

          <!-- Badge años -->
          <div
            class="absolute -top-4 -right-4 flex h-16 w-16 flex-col items-center justify-center rounded-2xl border border-rose-500/20 shadow-lg"
            style="background: rgba(163, 107, 126, 0.15); backdrop-filter: blur(12px);"
            aria-hidden="true"
          >
            <span class="text-xl leading-none font-semibold text-white">
              {about.badgeYears}
            </span>
            <span class="text-[8px] leading-tight tracking-wider text-rose-500 uppercase">
              {about.badgeLabelTop}<br/>{about.badgeLabelBottom}
            </span>
          </div>
        </div>
      </div>

      <!-- Texto e info -->
      <div class="flex flex-col gap-7" data-fade-in>
        <div>
          {
            about.paragraphs.map((paragraph) => (
              <p class="text-base leading-relaxed font-light text-white/80 first:mt-0 mt-3">
                {paragraph}
              </p>
            ))
          }
        </div>

        <!-- Stats en glass pills -->
        <div class="grid grid-cols-2 gap-3">
          {stats.map((stat) => <Stat value={stat.value} label={stat.label} />)}
        </div>

        <!-- Datos de ubicación -->
        <div class="flex flex-col gap-3">
          {aboutContactItems.map((item) => <ContactItem item={item} tone="light" />)}
        </div>
      </div>
    </div>
  </Container>
</section>
