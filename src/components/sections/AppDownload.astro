---
/**
 * Sección "Lleva a Yoss en tu bolsillo" con beneficios y CTAs a stores.
 */
import { benefits } from '../../data/benefits';
import BenefitItem from '../ui/BenefitItem.astro';
import StoreButton from '../ui/StoreButton.astro';
import Container from '../ui/Container.astro';
---

<section
  id="app"
  class="relative overflow-hidden bg-ink-800 px-4 py-20"
  aria-label="Descarga la aplicación de Yoss Beauty Salon"
>
  <!-- Decoración de fondo -->
  <div
    class="pointer-events-none absolute top-0 right-0 h-96 w-96 -translate-y-1/2 translate-x-1/4 rounded-full bg-rose-500/5 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute bottom-0 left-0 h-64 w-64 -translate-x-1/4 translate-y-1/3 rounded-full bg-rose-500/5 blur-3xl"
    aria-hidden="true"
  ></div>

  <Container width="md" class="relative z-10">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Izquierda: beneficios -->
      <div class="flex flex-col gap-8">
        <div data-animate="fade-up">
          <span
            class="text-xs tracking-[0.3em] text-rose-500 font-medium uppercase"
          >
            Nuestra App
          </span>
          <h2
            class="mt-3 font-serif text-4xl leading-tight font-light text-white md:text-5xl"
          >
            Lleva a Yoss en<br />
            <em class="not-italic text-rose-300">tu bolsillo</em>
          </h2>
          <p class="mt-4 max-w-sm text-sm leading-relaxed font-light text-white/50">
            Agenda, gestiona y disfruta tu experiencia en el salón desde la
            comodidad de tu teléfono.
          </p>
        </div>

        <ul data-animate-stagger class="flex flex-col gap-4" role="list">
          {benefits.map((benefit) => <BenefitItem benefit={benefit} />)}
        </ul>

        <div data-animate="fade-up" class="flex flex-col gap-3 sm:flex-row">
          <StoreButton store="ios" id="cta-app-store" />
          <StoreButton store="play" id="cta-google-play" />
        </div>
      </div>

      <!-- Derecha: espacio reservado para mockup futuro -->
      <div class="flex items-center justify-center lg:justify-end" aria-hidden="true">
        <!-- Espacio disponible para contenido futuro -->
      </div>
    </div>
  </Container>
</section>
