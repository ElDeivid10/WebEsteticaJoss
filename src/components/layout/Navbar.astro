---
/**
 * Navbar sticky con glassmorphism.
 * Maneja scroll, link activo y toggle del menú móvil.
 */
import { navigation } from '../../data/navigation';
import Icon from '../ui/Icon.astro';
import MobileMenu from './MobileMenu.astro';
---

<header
  id="site-navbar"
  data-scrolled="false"
  class="fixed top-4 left-1/2 z-50 w-[95%] max-w-md -translate-x-1/2 transition-all duration-300"
  aria-label="Navegación principal"
>
  <nav
    class="flex items-center justify-center rounded-full border border-rose-200/50 bg-white/95 px-5 py-3 shadow-2xl backdrop-blur-2xl"
    role="navigation"
  >
    <ul class="flex items-center gap-4 sm:gap-6" role="list">
      {
        navigation.map((link) => (
          <li>
            <a
              href={link.href}
              data-section-id={link.id}
              aria-label={link.ariaLabel}
              class="nav-link rounded-full px-3 py-1.5 text-xs font-medium text-ink-700 transition-colors hover:text-rose-500 sm:text-sm"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="absolute right-4 flex h-9 w-9 items-center justify-center rounded-full text-ink-700 transition-colors hover:bg-rose-50 md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-5 w-5" />
    </button>
  </nav>
</header>

<MobileMenu />

<script>
  import { initScrollBehavior } from '../../lib/scroll-observer';
  initScrollBehavior();
</script>

<style>
  /* Estado scrolled — se aplica al <nav> (no al <header>)
     para que el border-radius y backdrop-filter funcionen correctamente. */
  #site-navbar[data-scrolled='true'] nav {
    background: rgba(26, 22, 24, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-color: rgba(163, 107, 126, 0.25);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.4);
  }

  #site-navbar[data-scrolled='true'] .nav-link {
    color: white;
  }

  /* Link activo */
  .nav-link[data-active='true'] {
    color: var(--color-rose-500);
    background: rgba(163, 107, 126, 0.1);
  }

  #site-navbar[data-scrolled='true'] .nav-link[data-active='true'] {
    color: var(--color-rose-300);
  }

  /* Mostrar toggle solo en mobile (override del absolute) */
  #mobile-menu-toggle {
    display: flex;
  }

  @media (min-width: 768px) {
    #mobile-menu-toggle {
      display: none;
    }
  }
</style>
