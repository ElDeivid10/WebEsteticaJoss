---
interface Props {
  class?: string;
  'aria-label'?: string;
}
const { class: className, 'aria-label': ariaLabel } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaLabel ? undefined : true}
  aria-label={ariaLabel}
>
