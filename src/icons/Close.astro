---
interface Props {
  class?: string;
  'aria-label'?: string;
}
const { class: className, 'aria-label': ariaLabel } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={ariaLabel ? undefined : true}
  aria-label={ariaLabel}
>
  <path d="M6 18 18 6M6 6l12 12" />
</svg>
