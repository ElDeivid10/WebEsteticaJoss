<script>
  // Parallax para el contenedor tipo app
  const mainScroll = document.getElementById('app-container');
  const parallaxBg = document.getElementById('parallax-bg');
  const parallaxNosotros = document.getElementById('parallax-nosotros');
  
  if (mainScroll) {
    mainScroll.addEventListener('scroll', () => {
      const scrolled = mainScroll.scrollTop;
      
      // Hero Parallax
      if (parallaxBg) {
        parallaxBg.style.transform = `translateY(${scrolled * 0.4}px) scale(1.1)`;
      }
      
      // Nosotros Parallax
      if (parallaxNosotros) {
        const section = document.getElementById('nosotros');
        if (section) {
          const rect = section.getBoundingClientRect();
          // Parallax effect based on element position in viewport
          if (rect.top < window.innerHeight && rect.bottom > 0) {
             const offset = (window.innerHeight - rect.top) * 0.3;
             parallaxNosotros.style.transform = `translateY(${offset}px) scale(1.1)`;
          }
        }
      }
    });
  }
</script>

