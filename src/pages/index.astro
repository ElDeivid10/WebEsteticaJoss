---
import Layout from '../layouts/Layout.astro';
---

<Layout>

<!-- ═══════════════════════════════════════════════
     NAVBAR — sticky glassmorphism
═══════════════════════════════════════════════ -->
<header id="navbar" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[95%] max-w-md transition-all duration-300" aria-label="Navegación principal">
  <nav class="bg-white/95 backdrop-blur-2xl shadow-2xl border border-gray-200/50 rounded-full px-5 py-3 flex items-center justify-center" role="navigation">
    
    <!-- Navigation Links -->
    <ul class="flex items-center gap-4 sm:gap-6" role="list">
      <li>
        <a href="#hero" class="text-xs sm:text-sm font-medium text-gray-700 hover:text-[#a36b7e] transition-colors" aria-label="Ir a inicio">Inicio</a>
      </li>
      <li>
        <a href="#servicios" class="text-xs sm:text-sm font-medium text-gray-700 hover:text-[#a36b7e] transition-colors" aria-label="Ver catálogo de servicios">Catálogo</a>
      </li>
      <li>
        <a href="#nosotros" class="text-xs sm:text-sm font-medium text-gray-700 hover:text-[#a36b7e] transition-colors" aria-label="Conocer más sobre nosotros">Nosotros</a>
      </li>
      <li>
        <a href="#app" class="text-xs sm:text-sm font-medium text-[#a36b7e] transition-colors flex items-center gap-1" aria-label="Nuestra aplicación">
          App
        </a>
      </li>
    </ul>
  </nav>
</header>

<!-- ═══════════════════════════════════════════════
     HERO — parallax + liquid glass orbs
═══════════════════════════════════════════════ -->
<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
  aria-label="Hero del salón de belleza Yoss"
>
  <!-- Imagen con parallax via JS -->
  <div id="parallax-bg"
       class="absolute inset-0 scale-110"
       style="background-image:url('/hero_salon.jpg');background-size:cover;background-position:center top;will-change:transform;">
  </div>

  <!-- Overlay degradado en capas -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#2c2829]/75 via-[#2c2829]/50 to-[#2c2829]/90 z-[1]"></div>

  <!-- Liquid glass orbs decorativos -->
  <div class="absolute inset-0 z-[2] pointer-events-none overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-80 h-80 rounded-full opacity-20 blur-3xl animate-pulse-slow"
         style="background:radial-gradient(circle,#a36b7e 0%,transparent 70%);animation-duration:6s;"></div>
    <div class="absolute bottom-1/3 right-1/4 w-56 h-56 rounded-full opacity-15 blur-2xl animate-pulse-slow"
         style="background:radial-gradient(circle,#e8bfcc 0%,transparent 70%);animation-duration:8s;animation-delay:2s;"></div>
    <!-- Glass pill flotante -->
    <div class="absolute top-24 right-8 md:right-24 hidden sm:flex items-center gap-2 px-4 py-2 rounded-full border border-white/10"
         style="background:rgba(255,255,255,0.06);backdrop-filter:blur(12px);">
      <span class="w-1.5 h-1.5 rounded-full bg-[#a36b7e] animate-ping inline-block" style="animation-duration:2s;"></span>
      <span class="text-[10px] text-white/60 tracking-widest uppercase">Abierto hoy</span>
    </div>
  </div>

  <!-- Contenido del hero -->
  <div class="relative z-[3] text-center px-6 max-w-3xl mx-auto flex flex-col items-center gap-6 pt-20">
    <span class="inline-block text-xs tracking-[0.35em] uppercase text-[#a36b7e] px-5 py-2 rounded-full border border-[#a36b7e]/30"
          style="background:rgba(163,107,126,0.12);backdrop-filter:blur(8px);">
      Boutique Salón · Uruapan, Michoacán
    </span>

    <h1 class="text-5xl md:text-7xl font-light text-white tracking-tight leading-tight"
        style="font-family:'Cormorant Garamond',serif;">
      Yoss Beauty<br />
      <em class="not-italic font-extralight text-[#e8bfcc]">Salon</em>
    </h1>

    <p class="text-lg md:text-xl text-white/75 font-light tracking-wide max-w-md">
      Tu mejor versión comienza aquí.
    </p>

    <div class="flex items-center gap-3">
      <div class="h-px w-12 bg-[#a36b7e]/60"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-[#a36b7e]"></div>
      <div class="h-px w-12 bg-[#a36b7e]/60"></div>
    </div>

    <a id="cta-descargar-app" href="#app"
       class="group relative inline-flex items-center gap-3 bg-[#a36b7e] hover:bg-[#8f5a6b] text-white px-8 py-4 rounded-2xl text-base font-medium tracking-wide shadow-lg shadow-[#a36b7e]/30 transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-[#a36b7e]/40 overflow-hidden"
       aria-label="Descargar la app de Yoss Beauty Salon">
      <svg class="w-5 h-5 transition-transform duration-300 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3" />
      </svg>
      Descargar App para Agendar
      <span class="absolute -inset-full top-0 block h-full w-1/2 bg-white/10 skew-x-[-20deg] group-hover:translate-x-[400%] transition-transform duration-700"></span>
    </a>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 animate-bounce">
      <span class="text-[10px] text-white/40 tracking-widest uppercase">Scroll</span>
      <svg class="w-4 h-4 text-white/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
      </svg>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     INFO BAR
═══════════════════════════════════════════════ -->
<section id="info-bar" class="bg-[#a36b7e] text-white py-6 px-4" aria-label="Información de contacto y horarios">
  <div class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-4">

    <div class="flex items-center justify-center sm:justify-start gap-3">
      <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-white/70 font-light">Ubicación</p>
        <p class="font-medium text-sm mt-0.5">Uruapan, Michoacán</p>
      </div>
    </div>

    <div class="hidden sm:flex items-center justify-center gap-3">
      <div class="w-px h-10 bg-white/20"></div>
      <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-white/70 font-light">Lunes – Viernes</p>
        <p class="font-medium text-sm mt-0.5">11:00 AM – 2:00 PM</p>
        <p class="font-medium text-sm">4:00 PM – 7:00 PM</p>
      </div>
      <div class="w-px h-10 bg-white/20"></div>
    </div>

    <div class="flex items-center justify-center gap-3 sm:hidden">
      <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-white/70 font-light">Lunes – Viernes</p>
        <p class="font-medium text-sm mt-0.5">11:00 AM – 2:00 PM · 4:00 PM – 7:00 PM</p>
      </div>
    </div>

    <div class="flex items-center justify-center sm:justify-end gap-3">
      <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-white/70 font-light">Sábado</p>
        <p class="font-medium text-sm mt-0.5">11:00 AM – 6:00 PM</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     CATÁLOGO DE SERVICIOS
═══════════════════════════════════════════════ -->
<section id="servicios" class="bg-[#fcf9fa] py-20 px-4" aria-label="Catálogo de servicios">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <span class="text-xs tracking-[0.3em] uppercase text-[#a36b7e] font-medium">Lo que ofrecemos</span>
      <h2 class="mt-3 text-4xl md:text-5xl font-light text-[#2c2829] leading-tight" style="font-family:'Cormorant Garamond',serif;">
        Catálogo de Servicios
      </h2>
      <div class="mt-4 flex items-center justify-center gap-2">
        <div class="h-px w-10 bg-[#a36b7e]/40"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-[#a36b7e]"></div>
        <div class="h-px w-10 bg-[#a36b7e]/40"></div>
      </div>
      <p class="mt-4 text-[#2c2829]/60 font-light max-w-md mx-auto text-sm leading-relaxed">
        Tratamientos de alta calidad pensados para realzar tu belleza natural en un ambiente exclusivo.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

      <!-- Corte de Cabello -->
      <article id="servicio-corte" class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-md border border-[#f0eaec] hover:border-[#a36b7e]/20 transition-all duration-300 hover:-translate-y-1 flex flex-col gap-4" aria-label="Corte de cabello">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300" style="background-color:rgba(163,107,126,0.08)">
          <svg class="w-6 h-6 text-[#a36b7e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.848 8.25l1.536.887M7.848 8.25a3 3 0 1 1-5.196-3 3 3 0 0 1 5.196 3Zm1.536.887a2.165 2.165 0 0 1 1.083 1.839c.005.351.054.695.14 1.024M9.384 9.137l2.077 1.199M7.848 15.75l1.536-.887m-1.536.887a3 3 0 1 1-5.196 3 3 3 0 0 1 5.196-3Zm1.536-.887a2.165 2.165 0 0 0 1.083-1.839 8.956 8.956 0 0 0 .14-1.024m-1.223 2.863 2.077-1.199m0-3.328a4.323 4.323 0 0 1 2.068-1.379l5.325-1.628a4.5 4.5 0 0 1 2.48-.044l.803.215-7.794 4.5m-2.882-1.664A4.331 4.331 0 0 0 10.607 12m3.736 0 7.794 4.5-.803.215a4.5 4.5 0 0 1-2.48-.043l-5.326-1.629a4.324 4.324 0 0 1-2.068-1.379M14.343 12l-2.882 1.664" />
          </svg>
        </div>
        <div class="flex-1">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h3 class="text-lg font-medium text-[#2c2829]" style="font-family:'Cormorant Garamond',serif;">Corte de Cabello</h3>
            <span class="flex-shrink-0 text-[10px] font-semibold tracking-wider uppercase bg-[#a36b7e]/10 text-[#a36b7e] px-2 py-0.5 rounded-full border border-[#a36b7e]/20">20–30 MIN</span>
          </div>
          <p class="text-sm text-[#2c2829]/55 font-light leading-relaxed">Cortes clásicos y modernos adaptados a tu estilo y tipo de rostro.</p>
        </div>
        <div class="h-px bg-gradient-to-r from-[#a36b7e]/30 to-transparent"></div>
        <a href="#app" class="text-xs text-[#a36b7e] font-medium tracking-wide hover:underline underline-offset-2">Agendar cita →</a>
      </article>

      <!-- Coloración y Tinte -->
      <article id="servicio-coloracion" class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-md border border-[#f0eaec] hover:border-[#a36b7e]/20 transition-all duration-300 hover:-translate-y-1 flex flex-col gap-4" aria-label="Coloración y tinte">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300" style="background-color:rgba(163,107,126,0.08)">
          <svg class="w-6 h-6 text-[#a36b7e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42" />
          </svg>
        </div>
        <div class="flex-1">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h3 class="text-lg font-medium text-[#2c2829]" style="font-family:'Cormorant Garamond',serif;">Coloración y Tinte</h3>
            <span class="flex-shrink-0 text-[10px] font-semibold tracking-wider uppercase bg-[#a36b7e]/10 text-[#a36b7e] px-2 py-0.5 rounded-full border border-[#a36b7e]/20">2–8 HORAS</span>
          </div>
          <p class="text-sm text-[#2c2829]/55 font-light leading-relaxed">Desde mechas hasta tintes completos. Tonos personalizados con productos de calidad.</p>
          <div class="mt-3 flex items-start gap-2 bg-amber-50 border border-amber-200/70 rounded-lg px-3 py-2">
            <svg class="w-3.5 h-3.5 text-amber-500 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
            </svg>
            <p class="text-[10px] text-amber-700 font-medium leading-tight">Requiere anticipo mediante la app</p>
          </div>
        </div>
        <div class="h-px bg-gradient-to-r from-[#a36b7e]/30 to-transparent"></div>
        <a href="#app" class="text-xs text-[#a36b7e] font-medium tracking-wide hover:underline underline-offset-2">Agendar cita →</a>
      </article>

      <!-- Depilación -->
      <article id="servicio-depilacion" class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-md border border-[#f0eaec] hover:border-[#a36b7e]/20 transition-all duration-300 hover:-translate-y-1 flex flex-col gap-4" aria-label="Depilación">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300" style="background-color:rgba(163,107,126,0.08)">
          <svg class="w-6 h-6 text-[#a36b7e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
          </svg>
        </div>
        <div class="flex-1">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h3 class="text-lg font-medium text-[#2c2829]" style="font-family:'Cormorant Garamond',serif;">Depilación</h3>
            <span class="flex-shrink-0 text-[10px] font-semibold tracking-wider uppercase bg-[#a36b7e]/10 text-[#a36b7e] px-2 py-0.5 rounded-full border border-[#a36b7e]/20">30 MIN</span>
          </div>
          <p class="text-sm text-[#2c2829]/55 font-light leading-relaxed">Técnicas de depilación suaves y eficaces para una piel perfectamente suave.</p>
        </div>
        <div class="h-px bg-gradient-to-r from-[#a36b7e]/30 to-transparent"></div>
        <a href="#app" class="text-xs text-[#a36b7e] font-medium tracking-wide hover:underline underline-offset-2">Agendar cita →</a>
      </article>

      <!-- Uñas y Tratamientos -->
      <article id="servicio-unas" class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-md border border-[#f0eaec] hover:border-[#a36b7e]/20 transition-all duration-300 hover:-translate-y-1 flex flex-col gap-4" aria-label="Uñas y tratamientos">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300" style="background-color:rgba(163,107,126,0.08)">
          <svg class="w-6 h-6 text-[#a36b7e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
          </svg>
        </div>
        <div class="flex-1">
          <div class="flex items-start justify-between gap-2 mb-2">
            <h3 class="text-lg font-medium text-[#2c2829]" style="font-family:'Cormorant Garamond',serif;">Uñas y Tratamientos</h3>
            <span class="flex-shrink-0 text-[10px] font-semibold tracking-wider uppercase bg-[#a36b7e]/10 text-[#a36b7e] px-2 py-0.5 rounded-full border border-[#a36b7e]/20">Variable</span>
          </div>
          <p class="text-sm text-[#2c2829]/55 font-light leading-relaxed">Manicure, pedicure y tratamientos especializados para manos y pies impecables.</p>
        </div>
        <div class="h-px bg-gradient-to-r from-[#a36b7e]/30 to-transparent"></div>
        <a href="#app" class="text-xs text-[#a36b7e] font-medium tracking-wide hover:underline underline-offset-2">Agendar cita →</a>
      </article>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════
     NOSOTROS — con parallax de fondo y foto de dueña
═══════════════════════════════════════════════ -->
<section id="nosotros" class="relative py-24 px-4 overflow-hidden" aria-label="Quiénes somos">
  <!-- Fondo con parallax -->
  <div id="parallax-nosotros"
       class="absolute inset-0 scale-110"
       style="background-image:url('/hero_salon.jpg');background-size:cover;background-position:center;will-change:transform;filter:brightness(0.15) saturate(0.5);">
  </div>
  <!-- Overlay con gradiente y textura -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#2c2829]/95 via-[#2c2829]/85 to-[#1a0f12]/95"></div>
  <!-- Orbs de color -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full opacity-10 blur-3xl pointer-events-none"
       style="background:radial-gradient(ellipse,#a36b7e 0%,transparent 70%);">
  </div>

  <div class="relative z-10 max-w-5xl mx-auto">
    <!-- Header sección -->
    <div class="text-center mb-14">
      <span class="text-xs tracking-[0.3em] uppercase text-[#a36b7e] font-medium">Conoce al equipo</span>
      <h2 class="mt-3 text-4xl md:text-5xl font-light text-white leading-tight" style="font-family:'Cormorant Garamond',serif;">
        Nuestra Historia
      </h2>
      <div class="mt-4 flex items-center justify-center gap-2">
        <div class="h-px w-10 bg-[#a36b7e]/40"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-[#a36b7e]"></div>
        <div class="h-px w-10 bg-[#a36b7e]/40"></div>
      </div>
    </div>

