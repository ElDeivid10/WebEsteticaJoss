<!-- ═══════════════════════════════════════════════
     SCRIPTS — Navbar scroll + Parallax + Mobile menu
═══════════════════════════════════════════════ -->
<script>
  // ── Navbar: glassmorphism al hacer scroll ──────────────────
  const navbar = document.getElementById('navbar') as HTMLElement;
  const navLogo = document.getElementById('nav-logo') as HTMLElement;

  function updateNavbar() {
    const scrolled = window.scrollY > 60;
    if (scrolled) {
      navbar.style.background = 'rgba(26,22,24,0.85)';
      navbar.style.backdropFilter = 'blur(20px)';
      navbar.style.webkitBackdropFilter = 'blur(20px)';
      navbar.style.borderBottom = '1px solid rgba(163,107,126,0.15)';
      navbar.style.paddingTop = '0';
      navbar.style.paddingBottom = '0';
      if (navLogo) navLogo.style.color = 'white';
    } else {
      navbar.style.background = 'transparent';
      navbar.style.backdropFilter = 'none';
      navbar.style.webkitBackdropFilter = 'none';
      navbar.style.borderBottom = 'none';
      if (navLogo) navLogo.style.color = 'white';
    }
  }

  // Active link highlight based on scroll position
  const sections = ['hero','servicios','nosotros','app'] as const;
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

  function updateActiveLink() {
    let current = 'hero';
    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.offsetTop - 120) current = id;
    });
    navLinks.forEach(link => {
      const href = link.getAttribute('href') ?? '';
      if (href === `#${current}`) {
        link.style.color = '#a36b7e';
        link.style.background = 'rgba(163,107,126,0.1)';
      } else {
        link.style.color = '';
        link.style.background = '';
      }
    });
  }

  window.addEventListener('scroll', () => { updateNavbar(); updateActiveLink(); }, { passive: true });
  updateNavbar();
  updateActiveLink();

  // ── Parallax ─────────────────────────────────────────────
  const parallaxBg = document.getElementById('parallax-bg') as HTMLElement | null;
  const parallaxNosotros = document.getElementById('parallax-nosotros') as HTMLElement | null;
  const heroSection = document.getElementById('hero') as HTMLElement | null;
  const nosotrosSection = document.getElementById('nosotros') as HTMLElement | null;

  function updateParallax() {
    const scrollY = window.scrollY;

    if (parallaxBg && heroSection) {
      const heroH = heroSection.offsetHeight;
      if (scrollY <= heroH) {
        const ratio = scrollY / heroH;
        parallaxBg.style.transform = `translateY(${ratio * 60}px) scale(1.12)`;
        // Blur progresivo al hacer scroll
        parallaxBg.style.filter = `blur(${ratio * 8}px) brightness(${1 - ratio * 0.3})`;
      }
    }

    if (parallaxNosotros && nosotrosSection) {
      const rect = nosotrosSection.getBoundingClientRect();
      const offset = -rect.top * 0.25;
      parallaxNosotros.style.transform = `translateY(${offset}px) scale(1.12)`;
    }
  }

  window.addEventListener('scroll', updateParallax, { passive: true });

  // ── Mobile menu toggle ────────────────────────────────────
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
  const bar1 = document.getElementById('bar1') as HTMLElement | null;
  const bar2 = document.getElementById('bar2') as HTMLElement | null;
  const bar3 = document.getElementById('bar3') as HTMLElement | null;

  let menuOpen = false;

  menuToggle?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    menuToggle.setAttribute('aria-expanded', String(menuOpen));
    if (mobileMenu) mobileMenu.classList.toggle('hidden', !menuOpen);
    // Animación hamburguesa → X
    if (bar1 && bar2 && bar3) {
      if (menuOpen) {
        bar1.style.transform = 'rotate(45deg) translateY(7px)';
        bar2.style.opacity = '0';
        bar3.style.transform = 'rotate(-45deg) translateY(-7px)';
      } else {
        bar1.style.transform = '';
        bar2.style.opacity = '';
        bar3.style.transform = '';
      }
    }
  });

  // Cerrar menú al hacer clic en un link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false;
      mobileMenu.classList.add('hidden');
      if (bar1 && bar2 && bar3) {
        bar1.style.transform = '';
        bar2.style.opacity = '';
        bar3.style.transform = '';
      }
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // ── Intersection Observer: fade-in on scroll ─────────────
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        (entry.target as HTMLElement).style.opacity = '1';
        (entry.target as HTMLElement).style.transform = 'translateY(0)';
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll<HTMLElement>('article, #nosotros .grid > div').forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(24px)';
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(el);
  });
</script>

